# Core application
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/lawyer
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
UPLOAD_ROOT_PATH=uploads
LOG_LEVEL=INFO
LOG_ROOT_PATH=logs
LOG_RETENTION_DAYS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STARTUP_MAX_ATTEMPTS=3
DATABASE_STARTUP_RETRY_DELAY_SECONDS=2

# Vector infrastructure
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=law_documents
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=lawyer
REDIS_CACHE_TTL_SECONDS=300

# Embedding provider
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30

# Retrieval tuning
VECTOR_DENSE_DIMENSION=3072
VECTOR_SPARSE_DIMENSION=262144
VECTOR_LEAF_CHUNK_SIZE=900
VECTOR_LEAF_CHUNK_OVERLAP=150
VECTOR_PARENT_GROUP_SIZE=4
VECTOR_SEARCH_TOP_K=5
VECTOR_AUTO_MERGE_THRESHOLD=2
